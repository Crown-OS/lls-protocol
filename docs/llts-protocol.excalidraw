  {
   "id": "te808",
   "type": "text",
   "x": 3400,
   "y": 4280,
   "width": 1386.0,
   "height": 56.25,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 432098343,
   "version": 1,
   "versionNonce": 57666234,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1762500000000,
   "link": null,
   "locked": false,
   "text": "Pairing in the node \u00b7 QR: BeginPairing \u2192 window{120 s, nonce} + OfferQrPairing + pairing beacon \u2192 QrOfferReady \u2192 PairingOffer{uri} \u00b7 scanner: PairWithQr \u2192 PairWithOffer\nNearby: both windows open \u2192 lower window nonce starts PairNearby \u2192 PairingCode \u2192 PairingRequest{code} \u2192 user confirms (auto-reject after 60 s, \u2264 4 pending)\nPaired \u2192 adopt peer (default features, Persist) \u00b7 close window \u00b7 refresh beacons \u00b7 ExportFfspLink on first Connected \u00b7 Forget \u2192 Goodbye(Unpaired), peer forgets too",
   "originalText": "Pairing in the node \u00b7 QR: BeginPairing \u2192 window{120 s, nonce} + OfferQrPairing + pairing beacon \u2192 QrOfferReady \u2192 PairingOffer{uri} \u00b7 scanner: PairWithQr \u2192 PairWithOffer\nNearby: both windows open \u2192 lower window nonce starts PairNearby \u2192 PairingCode \u2192 PairingRequest{code} \u2192 user confirms (auto-reject after 60 s, \u2264 4 pending)\nPaired \u2192 adopt peer (default features, Persist) \u00b7 close window \u00b7 refresh beacons \u00b7 ExportFfspLink on first Connected \u00b7 Forget \u2192 Goodbye(Unpaired), peer forgets too",
   "fontSize": 15,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
