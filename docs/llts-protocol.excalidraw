   "link": null,
   "locked": false,
   "text": "Audio (Opus, 10 ms): no parity, no NACK, delivered immediately \u00b7 Input: each packet repeats the last 4 batches, receiver dedups by batch sequence, key-state snapshot on change and every 500 ms \u00b7 Nack, Feedback, Probe, ProbeAck skip the pacer.",
   "originalText": "Audio (Opus, 10 ms): no parity, no NACK, delivered immediately \u00b7 Input: each packet repeats the last 4 batches, receiver dedups by batch sequence, key-state snapshot on change and every 500 ms \u00b7 Nack, Feedback, Probe, ProbeAck skip the pacer.",
   "fontSize": 15,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
