   "isDeleted": false,
   "boundElements": [],
   "updated": 1762500000000,
   "link": null,
   "locked": false,
   "text": "Control 0 (always open) and Data streams\nControl kind: channel_seq + cumulative_ack\nfragments \u2264 64 / msg, msg \u2264 64 KiB\n\u2264 256 fragments in flight, queue 1 MiB\ndelayed ACK 2 ms (now on gap / dup)\nbare ACK = DISCARDABLE\nRTO = clamp(3\u00b7RTT + 2 ms, 10 ms, 1 s)\nbackoff RTO \u00d7 2^(n\u22121), exponent \u2264 5\nUNORDERED \u2192 deliver on completion",
   "originalText": "Control 0 (always open) and Data streams\nControl kind: channel_seq + cumulative_ack\nfragments \u2264 64 / msg, msg \u2264 64 KiB\n\u2264 256 fragments in flight, queue 1 MiB\ndelayed ACK 2 ms (now on gap / dup)\nbare ACK = DISCARDABLE\nRTO = clamp(3\u00b7RTT + 2 ms, 10 ms, 1 s)\nbackoff RTO \u00d7 2^(n\u22121), exponent \u2264 5\nUNORDERED \u2192 deliver on completion",
   "fontSize": 14,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "re699",
   "lineHeight": 1.25,
   "autoResize": true
  },
